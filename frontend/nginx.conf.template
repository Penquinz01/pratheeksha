server {
    listen ${PORT};

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback
    location / {
        try_files $uri /index.html;
    }

    # Proxy API calls to the backend container (strips the /api prefix).
    # Only relevant when the frontend was built with VITE_API_URL=/api (same-origin
    # deployment, e.g. local docker-compose where "api" resolves on the compose network).
    # Resolved lazily so this container still starts fine when nothing ever hits /api/,
    # e.g. on Railway where the frontend calls the backend's public URL directly instead.
    location /api/ {
        resolver 127.0.0.11 valid=30s;
        set $upstream_api http://api:8000;
        proxy_pass $upstream_api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
