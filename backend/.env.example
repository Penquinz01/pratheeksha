# Copy to .env and fill in real values. Never commit .env.
# Local development URL (the dockerized API overrides this via docker-compose.yml)
DATABASE_URL=postgresql+psycopg://pratheeksha:change-me-db-password@127.0.0.1:5433/pratheeksha
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Set to false once the first admin user is registered
ALLOW_REGISTRATION=true

# Used by docker-compose for the postgres container
POSTGRES_USER=pratheeksha
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=pratheeksha
